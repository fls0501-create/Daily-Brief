# 이 파일은 예시입니다. 실제 키 값을 이 파일에 직접 적지 마세요.
# 로컬 개발 시에는 이 파일을 복사해서 .env 로 만들고 값을 채운 뒤 `netlify dev`로 실행하세요.
# 실제 배포(운영) 환경에서는 Netlify 대시보드의
#   Site settings > Environment variables
# 에서 아래와 동일한 이름으로 등록해야 합니다. (이 파일은 배포에 전혀 영향 없음)

# Google AI Studio(Gemini) API 키 — 완전 무료, 카드 등록 불필요, 만료 없음
# 발급: https://aistudio.google.com/apikey (Google 계정만 있으면 즉시 발급)
# 기사 검색은 Google News RSS(키 불필요)를 쓰고, 요약은 Gemini 무료 티어를 쓰므로
# 이 프로젝트 전체 운영 비용은 0원입니다.
GEMINI_API_KEY=

# (선택) 화면의 "새로고침" 버튼 또는 수동 URL 호출을 아무나 실행하지 못하도록 막는 비밀값
# 내부용 도구라면 비워둬도 무방합니다.
MANUAL_UPDATE_SECRET=
