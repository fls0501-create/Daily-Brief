# 이 파일은 예시입니다. 실제 키 값을 이 파일에 직접 적지 마세요.
# 실제 배포 환경에서는 Vercel 대시보드의
#   Project Settings > Environment Variables
# 에서 아래와 동일한 이름으로 등록해야 합니다. (이 파일은 배포에 전혀 영향 없음)

# Google AI Studio(Gemini) API 키 — 완전 무료, 카드 등록 불필요, 만료 없음
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Upstash Redis — 완전 무료 티어, 카드 등록 불필요
# 발급: https://console.upstash.com 에서 Redis 데이터베이스 생성 후 REST API 탭에서 확인
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (선택) 화면의 "새로고침" 버튼 또는 수동 URL 호출을 아무나 실행하지 못하도록 막는 비밀값
# 내부용 도구라면 비워둬도 무방합니다.
MANUAL_UPDATE_SECRET=

# (선택) Vercel Cron이 보내는 요청을 검증하기 위한 값
# Vercel 프로젝트 설정에서 자동 생성해주는 경우가 많습니다. 없어도 크론 자체는 동작합니다.
CRON_SECRET=
